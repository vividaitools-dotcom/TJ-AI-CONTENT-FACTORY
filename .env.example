# ---------------------------------------------------------------------------
# TJ AI CONTENT FACTORY - optional server configuration
# Every AI provider key is entered per user inside the app (Settings -> API Keys)
# and encrypted at rest. The variables below are only for server-side features.
# ---------------------------------------------------------------------------

# Required for stable encrypted storage of user API keys and session signing.
# Any long random string. If unset, a local development key is derived and
# encrypted values will not survive a key rotation.
APP_SECRET=

# Optional: where the SQLite database and generated media live.
# DATA_DIR=./data

# Optional: YouTube publishing (Module 7).
# Create a free OAuth 2.0 Client (type: Web application) in Google Cloud Console,
# enable "YouTube Data API v3", then add the redirect URI:
#   <your app url>/api/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: free YouTube trending source for Trend Research (no paid tier needed,
# the free daily quota is 10,000 units).
YOUTUBE_API_KEY=
